@page "/dashboard"
@inject IDashboardUserProvider DashboardUserProvider

<DxDashboard style="width: 100%; height: 800px;" @bind-WorkingMode="@workingMode" />

@code {
    private WorkingMode workingMode;

    protected override async Task OnInitializedAsync() {
        var userName = await DashboardUserProvider.GetUserNameAsync();

        workingMode = (userName == "admin" || userName == "user") ? WorkingMode.Designer : WorkingMode.ViewerOnly;
    }
}